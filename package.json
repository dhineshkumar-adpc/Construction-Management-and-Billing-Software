    "files": ["main.js", "index.html", "package.json", "vendor/**/*", "assets/**/*", "build/icon.ico"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "portable": { "artifactName": "Construction_Management_and_Billing.exe" },
    "asar": true,
    "compression": "maximum"
  }
